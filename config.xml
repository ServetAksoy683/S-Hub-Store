<?xml version='1.0' encoding='utf-8'?>
<widget id="com.shub.store" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>S-Hub Store</name>
    <description>S-Hub Store</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="http://*/*" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xff070b14" />
    <preference name="AndroidWindowSplashScreenBackground" value="#070b14" />
    <preference name="Scheme" value="https" />
    <platform name="android">
        <icon density="mdpi" src="res/android/mdpi.png" />
        <icon density="hdpi" src="res/android/hdpi.png" />
        <icon density="xhdpi" src="res/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/android/xxxhdpi.png" />
    </platform>
</widget>
